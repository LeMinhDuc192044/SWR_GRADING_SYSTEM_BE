# =============================================================
# .env.example — Template only, KHÔNG chứa secret thật
# File này ĐƯỢC push lên git. Copy thành .env và điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env thật lên git.
# =============================================================

# ===== ASP.NET Core Environment =====
# Dev: Development | Production: Production
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ===== Database — Supabase Postgres =====
# Lấy từ Supabase Dashboard → Project Settings → Database → Connection string (URI)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
SSL_MODE=Require

# ===== JWT =====
# Generate bằng: openssl rand -base64 64 (HOẶC dùng Secret Manager, KHÔNG hardcode)
JWT_SECRET=replace_with_random_64_char_string_here_minimum_32_chars
JWT_ISSUER=SwrAiGradingApi
JWT_AUDIENCE=SwrAiGradingClient
JWT_EXPIRY_MINUTES=60

# ===== Storage =====
# Local: Local | Production: Supabase
STORAGE_PROVIDER=Local
STORAGE_LOCAL_PATH=./storage
# Supabase Storage (chỉ dùng khi STORAGE_PROVIDER=Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=grading-files

# ===== AI Service (Server 2 hoặc OpenAI) =====
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_SECONDS=60

# ===== Server 2 (Backend Server 2 — Student & Grading) =====
SERVER2_BASE_URL=http://192.168.1.100:5000
SERVER2_API_KEY=
SERVER2_TIMEOUT_SECONDS=30

# ===== CORS =====
# Comma-separated URLs, dùng cho dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Logging =====
LOG_LEVEL=Information
SERILOG_MINIMUM_LEVEL=Information
